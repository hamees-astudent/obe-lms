<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot's default console logging, plus a separate file for the Claude
  marks-sheet extraction traffic. Levels and the console pattern still come from
  the logging.* keys in application.yml.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="CLAUDE_LOG_FILE" source="app.exams.extraction.log-file"
                    defaultValue="logs/claude-extraction.log"/>

    <appender name="CLAUDE_TRAFFIC" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${CLAUDE_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${CLAUDE_LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] %m%n%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Kept out of the console: one call is several KB of prompt and JSON. -->
    <logger name="com.lms.modules.exams.ClaudeTraffic" additivity="false">
        <appender-ref ref="CLAUDE_TRAFFIC"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
